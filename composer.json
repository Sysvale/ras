{
	"name": "sysvale/ras",
	"description": "API RAS para exportação do SUS",
	"keywords": [ "laravel", "sus", "esus", "ras" ],
	"homepage": "https://github.com/Sysvale/ras",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Sysvale/ras"
        }
    ],
	"license": [
		"GPL-3.0"
	],
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.5"
	},
	"autoload": {
		"psr-4": {
			"Thrift\\": "src/thrift",
			"Sysvale\\Ras\\": "src/"
		},
		"files": [
			"src/alias.php"
		]
	},
	"autoload-dev": {
		"psr-4": {
			"Sysvale\\Ras\\Tests\\": "tests/"
		}
	}
}
